{
  "name": "feathers-casl",
  "version": "3.1.0",
  "description": "Add access control with CASL to your feathers application.",
  "author": "fratzinger",
  "homepage": "https://feathers-casl.netlify.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/fratzinger/feathers-casl"
  },
  "keywords": [
    "feathers",
    "feathers.js",
    "feathers-plugin",
    "casl",
    "permissions",
    "authorization"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "src/**",
    "dist/**"
  ],
  "engines": {
    "node": ">= 22.0.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsdown",
    "version": "npm run build",
    "vitest": "vitest",
    "test": "vitest run",
    "test:casl6": "CASL_VERSION=6 vitest run",
    "typecheck:casl6": "tsc --noEmit -p tsconfig.casl6.json",
    "coverage": "vitest run --coverage",
    "bench": "tsdown && vitest bench --run",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack . --profile esm-only",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "peerDependencies": {
    "@casl/ability": "6.x || 7.x",
    "@feathersjs/feathers": "^5.0.0"
  },
  "dependencies": {
    "@feathersjs/errors": "^5.0.50",
    "@feathersjs/transport-commons": "^5.0.50",
    "feathers-utils": "^10.10.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@casl/ability": "^7.0.2",
    "@casl/ability-v6": "npm:@casl/ability@^6.8.1",
    "@feathers-community/eslint-config": "^0.3.0",
    "@feathersjs/adapter-commons": "^5.0.50",
    "@feathersjs/authentication": "^5.0.50",
    "@feathersjs/authentication-local": "^5.0.50",
    "@feathersjs/configuration": "^5.0.50",
    "@feathersjs/express": "^5.0.50",
    "@feathersjs/feathers": "^5.0.50",
    "@feathersjs/knex": "^5.0.50",
    "@feathersjs/memory": "^5.0.50",
    "@feathersjs/mongodb": "^5.0.50",
    "@feathersjs/socketio": "^5.0.50",
    "@feathersjs/socketio-client": "^5.0.50",
    "@fratzinger/feathers-kysely": "^0.14.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cors": "^2.8.6",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "feathers-fletching": "^2.0.7",
    "feathers-knex": "^8.0.1",
    "feathers-sequelize": "^7.0.3",
    "get-port": "^7.2.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "kysely": "^0.29.7",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "objection": "^4.2.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "sequelize": "^6.37.8",
    "sift": "^17.1.4",
    "socket.io-client": "^4.8.4",
    "sqlite3": "^6.0.1",
    "tsdown": "^0.23.1",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.4",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.5"
  }
}
